# Local administrator: a random password is generated on first npm run dev.
PROJECTS_ADMIN_USERNAME=admin
PROJECTS_ADMIN_PASSWORD=
# Production: set an explicit HTTPS origin, NODE_ENV=production and a private persistent data directory.
# PROJECTS_ALLOWED_ORIGINS=https://your-domain.example
# PROJECTS_DATA_DIR=/var/lib/yeon-solution
# PORT=3001
# HOST=127.0.0.1

# Quote mail: server-only SMTP credentials. Never use a VITE_ prefix.
# Set the receiving address explicitly, then restart npm run dev / npm start.
QUOTE_TO_EMAIL=
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Naver requires an application password issued after enabling two-step verification.
SMTP_PASSWORD=
# Optional sender address; defaults to SMTP_USER. Must be allowed by the provider.
SMTP_FROM=
